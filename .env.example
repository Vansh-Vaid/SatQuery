# SatQuery AI - Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# --- Planner Configuration ---
# "auto": use Claude when credentials resolve, else fallback to rules.
# Options: "auto" | "llm" | "rules"
SATQUERY_PLANNER=auto
SATQUERY_PLANNER_MODEL=claude-opus-5-5
SATQUERY_PLANNER_EFFORT=low

# --- Anthropic API Credentials (Optional for LLM planner) ---
# ANTHROPIC_API_KEY=your_api_key_here

# --- Adapted Vision-Language Model (VLM) ---
# "off": disabled | "hf": local transformers | "remote": HTTP POST endpoint
SATQUERY_VLM_BACKEND=off
SATQUERY_VLM_BASE=Qwen/Qwen3-VL-2B-Instruct
# SATQUERY_VLM_ADAPTER=checkpoints/vlm_adapter
# SATQUERY_VLM_ENDPOINT=http://127.0.0.1:8001/v1/chat/completions
SATQUERY_VLM_TIMEOUT=180

# --- Checkpoints (Trained Models) ---
SATQUERY_SCENE_CKPT=checkpoints/scene_resnet18.pt
SATQUERY_VRSBENCH_GROUND_CKPT=checkpoints/vrsbench_ground.pt
SATQUERY_VRSBENCH_CKPT=checkpoints/vrsbench_vqa.pt
SATQUERY_CDVQA_CKPT=checkpoints/cdvqa.pt
SATQUERY_RSVQA_CKPT=checkpoints/rsvqa_lr.pt
# SATQUERY_CHANGE_CKPT=checkpoints/change_detector.pt

# --- Limits & Uploads ---
SATQUERY_MAX_UPLOAD_MB=200
SATQUERY_MAX_PIXELS=16777216
SATQUERY_ALLOW_PNG=true
SATQUERY_MAX_QUERY_CHARS=1000

# --- Public Deployment & Concurrency ---
SATQUERY_MAX_CONCURRENT=2
SATQUERY_QUEUE_TIMEOUT=60
SATQUERY_RATE_LIMIT=0
SATQUERY_TRUSTED_PROXY_HOPS=0

# --- Storage & Startup ---
SATQUERY_RUN_DIR=runs
SATQUERY_PERSIST_RUNS=true
SATQUERY_WARM_UP=true
